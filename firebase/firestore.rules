rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Wajib deploy rules ini bersama kode. Pengaturan UI saja tidak cukup.
    function isVerifiedPKP() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email_verified == true
        && request.auth.token.email.matches('^.*@pkp\\.go\\.id$');
    }
    function isAdmin() {
      return isVerifiedPKP()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }
    function permissionExists() {
      return exists(/databases/$(database)/documents/userPermissions/$(request.auth.uid));
    }
    function isAllowedUser() {
      return isVerifiedPKP() && (
        isAdmin() || !permissionExists()
        || get(/databases/$(database)/documents/userPermissions/$(request.auth.uid)).data.active != false
      );
    }
    function isOwner(userId) {
      return isAllowedUser() && request.auth.uid == userId;
    }
    function hasGrant(module, key) {
      return isAllowedUser() && (
        isAdmin() || (
          !permissionExists() && (module == 'tukin' || module == 'lembur' || module == 'uangMakan')
        ) || (
          permissionExists()
          && get(/databases/$(database)/documents/userPermissions/$(request.auth.uid)).data.grants.get(module, {}).get(key, false) == true
        )
      );
    }
    function canView(module, section) {
      return hasGrant(module, section + '.view');
    }
    function canDo(module, section, action) {
      return canView(module, section) && hasGrant(module, section + '.' + action);
    }
    function anyLeaveView() {
      return canView('cuti','dashboard') || canView('cuti','data')
        || canView('cuti','kalender') || canView('cuti','pegawai')
        || canView('cuti','saldo') || canView('cuti','laporan');
    }
    function anyAssignmentView() {
      return canView('surat','dashboard') || canView('surat','data') || canView('surat','kalender');
    }
    function anyRegisterView() {
      return canView('register','dashboard') || canView('register','cases')
        || canView('register','reconcile') || canView('register','history');
    }
    function anyTrainingView() {
      return canView('pelatihan','dashboard') || canView('pelatihan','pegawai') || canView('pelatihan','data');
    }
    function anyUangMakanView() {
      return canView('uangMakan','dashboard') || canView('uangMakan','process') || canView('uangMakan','history');
    }
    function anyTukinView() {
      return canView('tukin','dashboard') || canView('tukin','process') || canView('tukin','history');
    }
    function anyLemburView() {
      return canView('lembur','dashboard') || canView('lembur','process') || canView('lembur','history');
    }
    function canReadLeave() { return anyRegisterView() || anyLeaveView() || canView('tukin','process') || canView('uangMakan','process'); }
    function canReadAssignments() { return anyRegisterView() || anyAssignmentView() || canView('tukin','process') || canView('uangMakan','process'); }
    function canReadDirectory() {
      return isAdmin() || anyRegisterView() || anyLeaveView() || anyAssignmentView() || anyTrainingView() || anyUangMakanView();
    }
    function canManageRun(data, module) {
      return isAllowedUser() && (data.ownerUid == request.auth.uid || isAdmin());
    }
    function leaveDocumentOnlyChange() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['documents','updatedAt','updatedBy'])
        && canView('cuti','data') && canView('cuti','documents');
    }
    function documentEditAllowed() {
      return leaveDocumentOnlyChange() && (
        (canDo('cuti','documents','create')
          && request.resource.data.get('documents', []).size() == resource.data.get('documents', []).size() + 1)
        || (canDo('cuti','documents','edit')
          && request.resource.data.get('documents', []).size() == resource.data.get('documents', []).size())
        || (canDo('cuti','documents','delete')
          && request.resource.data.get('documents', []).size() + 1 == resource.data.get('documents', []).size())
      );
    }
    function canSyncBalance() {
      return canDo('cuti','data','create') || canDo('cuti','data','edit') || canDo('cuti','data','delete');
    }
    function isValidBalance() {
      return request.resource.data.entitlement is number
        && request.resource.data.carryOver is number
        && request.resource.data.usage is number
        && request.resource.data.remaining is number
        && request.resource.data.entitlement >= 0
        && request.resource.data.carryOver >= 0
        && request.resource.data.usage >= 0
        && request.resource.data.remaining == request.resource.data.entitlement + request.resource.data.carryOver - request.resource.data.usage;
    }
    function canReadRun(module) {
      return module == 'tukin' ? anyTukinView() : anyLemburView();
    }
    function canCreateRun(module) {
      return module == 'tukin' ? canDo('tukin','process','save') : canDo('lembur','process','generate');
    }
    function canUpdateRun(module) { return canDo(module,'history','edit'); }
    function canDeleteRun(module) { return canDo(module,'history','delete'); }

    // Admin ditetapkan hanya di Firebase Console, tidak dari aplikasi web.
    match /admins/{userId} {
      allow read: if isVerifiedPKP() && (request.auth.uid == userId || isAdmin());
      allow write: if false;
    }
    // Hak akses dapat dibaca pengguna sendiri dan seluruh admin. Mutasi hanya admin.
    match /userPermissions/{userId} {
      allow read: if isVerifiedPKP() && (request.auth.uid == userId || isAdmin());
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['uid','active','grants','revision','updatedAt','updatedByUid','updatedByEmail','schemaVersion'])
        && request.resource.data.uid == userId
        && request.resource.data.active is bool
        && request.resource.data.grants is map
        && request.resource.data.revision is int
        && request.resource.data.revision >= 1;
      allow delete: if false;
    }
    // Profil publik internal hanya dapat ditulis pemilik pada field profil non-otoritatif.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['uid','email','displayName','photoURL','lastLoginAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email;
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid','email','displayName','photoURL','lastLoginAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email;
      allow delete: if false;
    }
    match /users/{userId}/lemburRuns/{runId} {
      allow read: if (isOwner(userId) || isAdmin()) && canReadRun('lembur');
      allow create: if isOwner(userId) && canCreateRun('lembur');
      allow update: if (isOwner(userId) || isAdmin()) && canUpdateRun('lembur');
      allow delete: if (isOwner(userId) || isAdmin()) && canDeleteRun('lembur');
      match /employees/{employeeId} {
        allow read: if (isOwner(userId) || isAdmin()) && canReadRun('lembur');
        allow create: if isOwner(userId) && canCreateRun('lembur');
        allow update: if (isOwner(userId) || isAdmin()) && canUpdateRun('lembur');
        allow delete: if (isOwner(userId) || isAdmin()) && canDeleteRun('lembur');
      }
    }
    match /users/{userId}/tukinRuns/{runId} {
      allow read: if (isOwner(userId) || isAdmin()) && canReadRun('tukin');
      allow create: if isOwner(userId) && canCreateRun('tukin');
      allow update: if (isOwner(userId) || isAdmin()) && canUpdateRun('tukin');
      allow delete: if (isOwner(userId) || isAdmin()) && canDeleteRun('tukin');
      match /employees/{employeeId} {
        allow read: if (isOwner(userId) || isAdmin()) && canReadRun('tukin');
        allow create: if isOwner(userId) && canCreateRun('tukin');
        allow update: if (isOwner(userId) || isAdmin()) && canUpdateRun('tukin');
        allow delete: if (isOwner(userId) || isAdmin()) && canDeleteRun('tukin');
      }
    }
    match /lemburRuns/{runId} {
      allow read: if canReadRun('lembur');
      allow create: if canCreateRun('lembur') && request.resource.data.ownerUid == request.auth.uid;
      allow update: if canUpdateRun('lembur') && canManageRun(resource.data,'lembur')
        && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if canDeleteRun('lembur') && canManageRun(resource.data,'lembur');
      match /employees/{employeeId} {
        allow read: if canReadRun('lembur');
        allow create: if canCreateRun('lembur')
          && canManageRun(get(/databases/$(database)/documents/lemburRuns/$(runId)).data,'lembur');
        allow update: if canUpdateRun('lembur')
          && canManageRun(get(/databases/$(database)/documents/lemburRuns/$(runId)).data,'lembur');
        allow delete: if (canUpdateRun('lembur') || canDeleteRun('lembur'))
          && canManageRun(get(/databases/$(database)/documents/lemburRuns/$(runId)).data,'lembur');
      }
    }
    match /tukinRuns/{runId} {
      allow read: if canReadRun('tukin');
      allow create: if canCreateRun('tukin') && request.resource.data.ownerUid == request.auth.uid;
      allow update: if canUpdateRun('tukin') && canManageRun(resource.data,'tukin')
        && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if canDeleteRun('tukin') && canManageRun(resource.data,'tukin');
      match /employees/{employeeId} {
        allow read: if canReadRun('tukin');
        allow create: if canCreateRun('tukin')
          && canManageRun(get(/databases/$(database)/documents/tukinRuns/$(runId)).data,'tukin');
        allow update: if canUpdateRun('tukin')
          && canManageRun(get(/databases/$(database)/documents/tukinRuns/$(runId)).data,'tukin');
        allow delete: if (canUpdateRun('tukin') || canDeleteRun('tukin'))
          && canManageRun(get(/databases/$(database)/documents/tukinRuns/$(runId)).data,'tukin');
      }
    }
    match /lemburRunDeletions/{runId} {
      allow read: if canReadRun('lembur');
      allow create: if canDeleteRun('lembur')
        && (request.resource.data.ownerUid == request.auth.uid || isAdmin());
      allow update: if canDeleteRun('lembur')
        && (resource.data.ownerUid == request.auth.uid || isAdmin())
        && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if false;
    }
    match /tukinRunDeletions/{runId} {
      allow read: if canReadRun('tukin');
      allow create: if canDeleteRun('tukin')
        && (request.resource.data.ownerUid == request.auth.uid || isAdmin());
      allow update: if canDeleteRun('tukin')
        && (resource.data.ownerUid == request.auth.uid || isAdmin())
        && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if false;
    }
    // Rekap Uang Makan: hasil per periode dan rincian harian disimpan per pegawai.
    match /uangMakanRuns/{runId} {
      allow read: if anyUangMakanView();
      allow create: if canDo('uangMakan','process','save') && request.resource.data.ownerUid == request.auth.uid;
      allow update: if canDo('uangMakan','process','save') && canManageRun(resource.data,'uangMakan')
        && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if canDo('uangMakan','history','delete') && canManageRun(resource.data,'uangMakan');
      match /employees/{employeeId} {
        allow read: if anyUangMakanView();
        allow create, update: if canDo('uangMakan','process','save')
          && canManageRun(get(/databases/$(database)/documents/uangMakanRuns/$(runId)).data,'uangMakan');
        allow delete: if canDo('uangMakan','history','delete')
          && canManageRun(get(/databases/$(database)/documents/uangMakanRuns/$(runId)).data,'uangMakan');
      }
    }
    match /masterEmployees/{masterId} {
      allow read: if isAllowedUser() && (canReadDirectory() || anyTukinView() || anyLemburView() || anyUangMakanView());
      allow create, update, delete: if isAdmin();
    }
    match /masterDirectory/{masterId} {
      allow read: if canReadDirectory();
      allow create, update, delete: if isAdmin();
    }
    match /appSettings/{settingId} {
      allow read: if isAllowedUser();
      allow create, update, delete: if isAdmin();
    }
    match /trainings/{trainingId} {
      allow read: if anyTrainingView();
      allow create: if canDo('pelatihan','data','create');
      // Status/catatan peserta dan metadata dokumen disimpan di array participants.
      // Perubahan array dibatasi ke field participants, bukan kolom utama pelatihan.
      allow update: if canDo('pelatihan','data','edit') || (
        canView('pelatihan','data')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants','participantIds','updatedAt','updatedBy','schemaVersion'])
        && (canDo('pelatihan','participants','edit')
          || canDo('pelatihan','documents','create')
          || canDo('pelatihan','documents','edit')
          || canDo('pelatihan','documents','delete'))
      );
      allow delete: if canDo('pelatihan','data','delete');
    }
    match /leaveRecords/{leaveId} {
      allow read: if canReadLeave();
      allow create: if canDo('cuti','data','create')
        && (request.resource.data.get('documents', []).size() == 0 || canDo('cuti','documents','create'));
      allow update: if (
        canDo('cuti','data','edit')
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['documents'])
          || canDo('cuti','documents','edit'))
      ) || documentEditAllowed();
      allow delete: if canDo('cuti','data','delete');
    }
    match /leaveBalances/{balanceId} {
      allow read: if canReadLeave();
      allow create: if isValidBalance() && (
        canDo('cuti','saldo','edit_balance') ||
        (canSyncBalance() && request.resource.data.entitlement == 0 && request.resource.data.carryOver == 0)
      );
      allow update: if isValidBalance() && (
        canDo('cuti','saldo','edit_balance') ||
        (canSyncBalance() && request.resource.data.entitlement == resource.data.entitlement
          && request.resource.data.carryOver == resource.data.carryOver
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usage','remaining','updatedAt','updatedBy','schemaVersion','employeeId','year']))
      );
      allow delete: if isAdmin();
    }
    match /assignmentRecords/{assignmentId} {
      allow read: if canReadAssignments();
      allow create: if canDo('surat','data','create') && (canDo('surat','documents','upload') || (request.resource.data.get('documents',[]).size() == 1 && request.resource.data.documents[0].get('file',null) == null));
      allow update: if canDo('surat','data','edit') && (
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['documents'])
        || canDo('surat','documents','upload')
        || (resource.data.get('documents',[]).size()>0
          && request.resource.data.get('documents',[]).size()>0
          && resource.data.documents[0].get('file',null) == request.resource.data.documents[0].get('file',null))
      );
      allow delete: if canDo('surat','data','delete');
    }
    // Register status administrasi kehadiran, tanpa hak mutasi terhadap dokumen sumber.
    function validAttendanceCase() {
      return request.resource.data.get('key','') is string
        && request.resource.data.get('type','') in ['conflict','realization']
        && request.resource.data.get('year',0) is int
        && request.resource.data.get('employeeId','') is string
        && request.resource.data.get('startDate','') is string
        && request.resource.data.get('endDate','') is string
        && request.resource.data.get('fingerprint','') is string
        && request.resource.data.get('workflow','') in ['pending','awaiting','verified']
        && request.resource.data.get('note','') is string
        && request.resource.data.get('sourceRefs',[]) is list
        && request.resource.data.get('actualDates',[]) is list
        && request.resource.data.get('updatedByUid','') == request.auth.uid
        && request.resource.data.get('updatedByEmail','') == request.auth.token.email;
    }
    match /attendanceCases/{caseId} {
      allow read: if anyRegisterView();
      allow create: if canDo('register','cases','create') && validAttendanceCase()
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.createdByEmail == request.auth.token.email
        && (request.resource.data.workflow != 'verified' || (canDo('register','cases','verify')
          && request.resource.data.verifiedByUid == request.auth.uid
          && request.resource.data.verifiedByEmail == request.auth.token.email));
      allow update: if validAttendanceCase()
        && request.resource.data.key == resource.data.key
        && request.resource.data.type == resource.data.type
        && request.resource.data.createdByUid == resource.data.createdByUid
        && request.resource.data.createdByEmail == resource.data.createdByEmail
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'kind','year','employeeId','startDate','endDate','sourceKey','sourceRefs',
          'fingerprint','workflow','realization','actualStart','actualEnd',
          'actualStartTime','actualEndTime','actualDates','clarifiedBy','evidence','note',
          'updatedAt','updatedByUid','updatedByEmail','verifiedAt','verifiedByUid','verifiedByEmail'
        ])
        && (request.resource.data.workflow == 'verified'
          ? (canDo('register','cases','verify')
            && request.resource.data.verifiedByUid == request.auth.uid
            && request.resource.data.verifiedByEmail == request.auth.token.email)
          : canDo('register','cases','edit'));
      allow delete: if false;
    }
    match /attendanceCaseLogs/{logId} {
      allow read: if canView('register','history');
      allow create: if (canDo('register','cases','create') || canDo('register','cases','edit') || canDo('register','cases','verify'))
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.actorEmail == request.auth.token.email
        && request.resource.data.get('caseKey','') is string
        && request.resource.data.get('detail','') is string
        && request.resource.data.get('year',0) is int
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
    match /attendanceReconciliations/{periodId} {
      allow read: if anyRegisterView();
      allow create, update: if canDo('register','reconcile','save')
        && request.resource.data.get('year',0) is int
        && request.resource.data.get('month',0) is int
        && request.resource.data.month >= 1 && request.resource.data.month <= 12
        && request.resource.data.get('status','') in ['pending','complete']
        && request.resource.data.get('fingerprint','') is string
        && request.resource.data.get('openCases',0) is int
        && request.resource.data.get('sourceConfirmation','') is string
        && (request.resource.data.status != 'complete'
          || (request.resource.data.openCases == 0 && request.resource.data.sourceConfirmation.size() > 0))
        && request.resource.data.get('reviewedByUid','') == request.auth.uid
        && request.resource.data.get('reviewedByEmail','') == request.auth.token.email;
      allow delete: if false;
    }
    match /adminAudit/{auditId} {
      allow read: if isAdmin();
      allow create: if isAllowedUser()
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.actorEmail == request.auth.token.email
        && request.resource.data.action is string
        && request.resource.data.target is string
        && request.resource.data.detail is string;
      allow update, delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
