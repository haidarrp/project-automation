rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAllowedUser() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email_verified == true
        && request.auth.token.email.matches('^.*@pkp\\.go\\.id$');
    }

    function isOwner(userId) {
      return isAllowedUser() && request.auth.uid == userId;
    }

    match /users/{userId} {
      // Profil dibuat/di-update oleh akun itu sendiri setelah login terverifikasi.
      allow read, create, update: if isOwner(userId);
      allow delete: if false;

      // Semua data aplikasi (lemburRuns, tukinRuns, employees) privat per UID.
      match /{document=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // Default deny untuk semua path lain.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
