rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAllowedUser() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email_verified == true
        && request.auth.token.email.matches('^.*@pkp\\.go\\.id$');
    }

    function isOwner(userId) {
      return isAllowedUser() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAllowedUser()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }

    function canManageSharedRun(data) {
      return isAllowedUser()
        && (data.ownerUid == request.auth.uid || isAdmin());
    }

    // Dokumen penanda administrator dibuat manual melalui Firebase Console.
    // Pengguna biasa hanya boleh membaca status admin miliknya sendiri.
    match /admins/{userId} {
      allow read: if isAllowedUser() && request.auth.uid == userId;
      allow write: if false;
    }

    // Area privat lama tetap dipertahankan agar data riwayat versi sebelumnya
    // dapat dimigrasikan oleh pemilik akun ke koleksi riwayat bersama.
    match /users/{userId} {
      allow read, create, update: if isOwner(userId);
      allow delete: if false;

      match /{document=**} {
        allow read, write: if isOwner(userId);
      }
    }



    // Koleksi riwayat privat versi lama. Pemilik tetap dapat mengelola datanya,
    // dan admin diberi hak delete agar hard-delete shared history juga dapat
    // membersihkan sumber legacy milik akun lain.
    match /users/{userId}/lemburRuns/{runId} {
      allow read, create, update, delete: if isOwner(userId) || isAdmin();
      match /employees/{employeeId} {
        allow read, create, update, delete: if isOwner(userId) || isAdmin();
      }
    }

    match /users/{userId}/tukinRuns/{runId} {
      allow read, create, update, delete: if isOwner(userId) || isAdmin();
      match /employees/{employeeId} {
        allow read, create, update, delete: if isOwner(userId) || isAdmin();
      }
    }

    // Riwayat Lembur bersama.
    // Semua akun instansi yang terverifikasi dapat membaca seluruh riwayat.
    // Riwayat hanya dapat dibuat oleh akun yang sedang login dan hanya dapat
    // diubah/dihapus oleh pembuatnya atau administrator.
    match /lemburRuns/{runId} {
      allow read: if isAllowedUser();
      allow create: if isAllowedUser()
        && request.resource.data.ownerUid == request.auth.uid;
      allow update: if canManageSharedRun(resource.data)
        && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if canManageSharedRun(resource.data);

      match /employees/{employeeId} {
        allow read: if isAllowedUser();
        allow create, update, delete: if isAllowedUser()
          && canManageSharedRun(
            get(/databases/$(database)/documents/lemburRuns/$(runId)).data
          );
      }
    }

    // Tombstone penghapusan Lembur. Dokumen ini sengaja dipertahankan
    // agar data legacy tidak dapat dimigrasikan kembali setelah riwayat dihapus.
    match /lemburRunDeletions/{runId} {
      allow read: if isAllowedUser();
      allow create: if isAdmin() || (
        isAllowedUser()
        && request.resource.data.ownerUid == request.auth.uid
      );
      allow update: if isAllowedUser()
        && (resource.data.ownerUid == request.auth.uid || isAdmin())
        && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if false;
    }

    // Riwayat Tunjangan Kinerja bersama, dengan model akses yang sama.
    match /tukinRuns/{runId} {
      allow read: if isAllowedUser();
      allow create: if isAllowedUser()
        && request.resource.data.ownerUid == request.auth.uid;
      allow update: if canManageSharedRun(resource.data)
        && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if canManageSharedRun(resource.data);

      match /employees/{employeeId} {
        allow read: if isAllowedUser();
        allow create, update, delete: if isAllowedUser()
          && canManageSharedRun(
            get(/databases/$(database)/documents/tukinRuns/$(runId)).data
          );
      }
    }

    // Tombstone penghapusan Tukin, dengan tujuan yang sama seperti Lembur.
    match /tukinRunDeletions/{runId} {
      allow read: if isAllowedUser();
      allow create: if isAdmin() || (
        isAllowedUser()
        && request.resource.data.ownerUid == request.auth.uid
      );
      allow update: if isAllowedUser()
        && (resource.data.ownerUid == request.auth.uid || isAdmin())
        && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if false;
    }

    // Master operasional hanya memuat hash identitas dan parameter yang diperlukan aplikasi.
    // Seluruh pengguna terverifikasi pada domain instansi boleh membaca; hanya admin boleh mengubah.
    match /masterEmployees/{masterId} {
      allow read: if isAllowedUser();
      allow create, update, delete: if isAdmin();
    }

    // Direktori plaintext (Nama/NIP/Unit) hanya untuk tampilan dan pengelolaan oleh admin.
    match /masterDirectory/{masterId} {
      allow read, create, update, delete: if isAdmin();
    }

    // Pengaturan operasional dibaca aplikasi dan hanya dapat diubah administrator.
    match /appSettings/{settingId} {
      allow read: if isAllowedUser();
      allow create, update, delete: if isAdmin();
    }

    // Arsip pelatihan bersifat internal Pusdatin dan dikelola oleh administrator aplikasi.
    match /trainings/{trainingId} {
      allow read, create, update, delete: if isAdmin();
    }

    // Pencatatan cuti internal TU. Modul ini bukan workflow persetujuan.
    match /leaveRecords/{leaveId} {
      allow read, create, update, delete: if isAdmin();
    }

    // Saldo Cuti Tahunan disimpan terpisah per pegawai per tahun.
    match /leaveBalances/{balanceId} {
      allow read, create, update, delete: if isAdmin();
    }

    // Arsip Surat Tugas/penugasan dinas internal TU. Satu record dapat memuat
    // beberapa pegawai dan menjadi data pendukung pada proses Tukin.
    match /assignmentRecords/{assignmentId} {
      allow read, create, update, delete: if isAdmin();
    }

    // Audit log bersifat append-only dari halaman admin.
    match /adminAudit/{auditId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // Default deny untuk seluruh path lain.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
